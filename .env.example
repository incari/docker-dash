# Server Port
PORT=3000

# Docker Socket Path (Default: /var/run/docker.sock)
DOCKER_SOCKET=/var/run/docker.sock

# Database Path (Default: ./data/dashboard.db)
DB_PATH=./data/dashboard.db

# Uploads Directory (Default: ./data/images)
UPLOAD_DIR=./data/images

# Node Environment (production/development)
NODE_ENV=production

# ============================================
# MULTI-SERVER (FLEET)
# ============================================
# Other machines are added from the dashboard, under Shortcuts -> Servers, as
# ssh://user@machine or tcp://machine:2375. Nothing here is needed for that.

# Name this machine's own Docker goes by in the dashboard. Defaults to the
# container/host name.
HOST_NAME=

# How long to wait for a remote server before giving up on it (ms).
HOST_TIMEOUT_MS=6000

# How long one fan-out across all servers is reused (ms). The
# dashboard polls every 5s per open tab; this keeps that from becoming one
# request per server per tab.
HOST_CACHE_MS=2000

# The least time between two real auto-syncs (ms). Auto-sync runs on
# every dashboard load and reads every server; without this, opening five tabs
# meant five full sweeps. Adding, removing or re-pointing a server clears it, so
# a change is never waited out.
AUTO_SYNC_INTERVAL_MS=60000

# How long a read of all servers may take before it answers with what
# it has (ms). A server that misses this keeps its previous containers on screen
# and its request finishes in the background, so one slow machine cannot hold
# the others up.
HOST_DEADLINE_MS=2000

# How long in-flight requests get to finish after SIGTERM before the process
# exits anyway (ms). Keep it below your Docker stop timeout, which is 10s.
SHUTDOWN_GRACE_MS=8000
