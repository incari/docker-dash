# Server Port
PORT=3000

# Docker Socket Path (Default: /var/run/docker.sock)
DOCKER_SOCKET=/var/run/docker.sock

# Or reach Docker over TCP through a socket proxy instead of mounting the
# socket - see docker-compose.socket-proxy.yml. Takes precedence over
# DOCKER_SOCKET when set.
# DOCKER_HOST=tcp://docker-socket-proxy:2375

# Behind a reverse proxy: how many proxies sit in front of this process, so the
# per-client rate limits read the visitor's address from X-Forwarded-For
# instead of counting everyone as the proxy. Leave unset otherwise.
# TRUST_PROXY=1

# Database Path (Default: ./data/dashboard.db)
DB_PATH=./data/dashboard.db

# Uploads Directory (Default: ./data/images)
UPLOAD_DIR=./data/images

# Node Environment (production/development)
NODE_ENV=production

# ============================================
# MULTI-SERVER (FLEET)
# ============================================
# Name this machine goes by. Shown as the server's name in the dashboard and
# reported to a hub that asks. Defaults to the container/host name.
HOST_NAME=

# The key another dashboard (the hub) must present to read this machine's
# containers over /api/agent.
#
# You usually do NOT need to set this. Left empty, the installation generates a
# key of its own on first boot and shows it in its own dashboard, under
# Servers - copy it from there into the hub. Reading stays switched off until
# you tick "let another dashboard read this server".
#
# Set it here only to pin the key from a compose file or a secrets manager.
# Doing so also switches reading on, and the key can no longer be changed from
# the dashboard.
API_KEY=

# Hub only: how long to wait for a remote server before giving up on it (ms).
HOST_TIMEOUT_MS=6000

# Hub only: how long one fan-out across all servers is reused (ms). The
# dashboard polls every 5s per open tab; this keeps that from becoming one
# request per server per tab.
HOST_CACHE_MS=2000

# Hub only: the least time between two real auto-syncs (ms). Auto-sync runs on
# every dashboard load and reads every server; without this, opening five tabs
# meant five full sweeps. Adding, removing or re-pointing a server clears it, so
# a change is never waited out.
AUTO_SYNC_INTERVAL_MS=60000

# Hub only: how long a read of all servers may take before it answers with what
# it has (ms). A server that misses this keeps its previous containers on screen
# and its request finishes in the background, so one slow machine cannot hold
# the others up.
HOST_DEADLINE_MS=2000

# How long in-flight requests get to finish after SIGTERM before the process
# exits anyway (ms). Keep it below your Docker stop timeout, which is 10s.
SHUTDOWN_GRACE_MS=8000
